# ===========================================================
# Dexcom Account Credentials
# ===========================================================
DEXCOM_EMAIL="your_email@example.com"
DEXCOM_PASSWORD="your_dexcom_password"

# ===========================================================
# Nightscout Configuration
# ===========================================================
NIGHTSCOUT_DOCKER_API_SECRET="your_nightscout_api_secret_min_12_chars"
API_SECRET="your_nightscout_api_secret_min_12_chars"
MONGO_CONNECTION="mongodb://mongo:27017/nightscout"

# ===========================================================
# Dexcom Bridge Configuration (Nightscout & Go Worker)
# ===========================================================
BRIDGE_USER_NAME="your_dexcom_username_or_phone_number"
BRIDGE_PASSWORD="your_dexcom_password"
BRIDGE_SERVER="EU" # Options: EU or US

# ===========================================================
# PostgreSQL Database Configuration
# ===========================================================
POSTGRES_USER="dexcom_user"
POSTGRES_PASSWORD="your_secure_database_password"
POSTGRES_DB="dexcom_db"

# PostgreSQL is accessed through the Docker internal network.
# The hostname is the Docker Compose service name: "db".
DATABASE_URL="postgresql://dexcom_user:your_secure_database_password@db:5432/dexcom_db"

# ===========================================================
# Backend API Configuration
# ===========================================================
# Generate a secure random string for your API Key
API_KEY="your_secure_random_api_key_here"