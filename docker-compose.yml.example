services:

  # ============================================================
  # 1. MONGO DATABASE
  # ============================================================
  # MongoDB database used internally by Nightscout.
  #
  # No host port is exposed.
  # Nightscout communicates with MongoDB through Docker's
  # internal network using the service name "mongo".
  #
  # Data is persisted in the "mongo_data" Docker volume.
  # ============================================================
  mongo:
    image: mongo:7.0
    container_name: nightscout_mongo
    restart: always

    # No ports section is required.
    # MongoDB is only accessible inside the Docker network.

    volumes:
      - mongo_data:/data/db


  # ============================================================
  # 2. NIGHTSCOUT
  # ============================================================
  # Nightscout is the CGM data server / web application.
  #
  # In this project, Nightscout acts as an intermediate layer
  # between Dexcom and the rest of the system.
  #
  # The Python backend can retrieve glucose data from Nightscout.
  #
  # Nightscout is bound to 127.0.0.1 on the host, meaning it
  # cannot be accessed directly from the public internet.
  #
  # Public access, when required, is handled by Nginx Proxy
  # Manager through HTTPS.
  # ============================================================
  nightscout:
    image: nightscout/cgm-remote-monitor:latest
    container_name: nightscout_app
    restart: always

    ports:
      # Host localhost -> container port 1337.
      # This service is NOT directly exposed to the internet.
      - "127.0.0.1:1337:1337"

    environment:
      # MongoDB connection string.
      - MONGO_CONNECTION=${MONGO_CONNECTION}

      # Secret used by Nightscout for authentication/security.
      - API_SECRET=${API_SECRET}

      # Enable the Nightscout features required by this project.
      - ENABLE=bridge careportal basal

      # Default role for authenticated users.
      - AUTH_DEFAULT_ROLES=readable

      # Dexcom account credentials used by the bridge.
      - BRIDGE_USER_NAME=${BRIDGE_USER_NAME}
      - BRIDGE_PASSWORD=${BRIDGE_PASSWORD}

      # Dexcom server region.
      - BRIDGE_SERVER=EU

      # Nightscout communicates internally over HTTP.
      # Public HTTPS is handled by Nginx Proxy Manager.
      - INSECURE_USE_HTTP=true

    depends_on:
      - mongo


  # ============================================================
  # 3. PYTHON BACKEND
  # ============================================================
  # Main backend application.
  #
  # Responsibilities include:
  #   - REST API
  #   - Glucose processing
  #   - PostgreSQL communication
  #   - Alarm management
  #   - Server-Sent Events (SSE)
  #   - Android client communication
  #   - Receiving glucose data from the Go worker
  #
  # The application listens on port 8000 inside the container.
  #
  # It is bound to 127.0.0.1 on the host so it is not directly
  # exposed to the public internet.
  #
  # Public HTTPS traffic is handled by Nginx Proxy Manager.
  # ============================================================
  api:
    build: .
    container_name: dexcom_backend
    restart: always

    ports:
      # Host localhost -> container port 8000.
      # This service is NOT directly exposed to the internet.
      - "127.0.0.1:8000:8000"

    depends_on:
      - db

    env_file:
      - .env

    environment:
      # PostgreSQL connection string.
      # The actual value must be stored in .env, not in Git.
      - DATABASE_URL=${DATABASE_URL}


  # ============================================================
  # 4. GO WORKER
  # ============================================================
  # Background worker responsible for communicating with Dexcom.
  #
  # It retrieves glucose data and sends it to the Python backend
  # through the internal Docker network.
  #
  # The worker does not need any published host port.
  # ============================================================
  go_worker:
    build: ./dexcom-go-worker
    container_name: dexcom_go_worker
    restart: always

    depends_on:
      - api

    environment:
      # Dexcom account credentials.
      - DEXCOM_USERNAME=${BRIDGE_USER_NAME}
      - DEXCOM_PASSWORD=${BRIDGE_PASSWORD}

      # Internal Docker URL of the Python backend.
      - WEBHOOK_URL=http://dexcom_backend:8000/api/v1/glucose/push-client-webhook

      # API key used when communicating with the backend.
      - API_KEY=${API_KEY}


  # ============================================================
  # 5. POSTGRESQL DATABASE
  # ============================================================
  # PostgreSQL database used by the Python backend.
  #
  # PostgreSQL has NO published host port.
  #
  # The Python backend reaches it through the Docker network
  # using the service name "db".
  #
  # Therefore, there is no need for:
  #
  #   ports:
  #     - "5432:5432"
  #
  # Data is persisted in the "postgres_data" Docker volume.
  # ============================================================
  db:
    image: postgres:15-alpine
    container_name: dexcom_postgres
    restart: always

    env_file:
      - .env

    volumes:
      - postgres_data:/var/lib/postgresql/data


  # ============================================================
  # 6. NGINX PROXY MANAGER
  # ============================================================
  # Nginx Proxy Manager is the public-facing reverse proxy.
  #
  # Public traffic flow:
  #
  #     Internet
  #        |
  #        | HTTPS :443
  #        v
  #    Nginx Proxy Manager
  #        |
  #        +----> Python API :8000
  #        |
  #        +----> Nightscout :1337
  #
  # Ports 80 and 443 are intentionally exposed publicly.
  #
  # Port 81 is the Nginx Proxy Manager administration interface.
  # It is bound to 127.0.0.1, so the administration panel is
  # only accessible from the server itself.
  #
  # Let's Encrypt certificates are stored in ./letsencrypt.
  # ============================================================
  npm:
    image: jc21/nginx-proxy-manager:latest
    container_name: nginx_proxy_manager
    restart: always

    ports:
      # Public HTTP.
      # Used for HTTP traffic and Let's Encrypt validation.
      - "80:80"

      # Public HTTPS.
      # Main secure entry point from the internet.
      - "443:443"

      # NPM administration interface.
      # Only accessible from the server itself.
      - "127.0.0.1:81:81"

    volumes:
      - ./npm_data:/data
      - ./letsencrypt:/etc/letsencrypt


# ============================================================
# DOCKER VOLUMES
# ============================================================
volumes:
  mongo_data:
  postgres_data:
